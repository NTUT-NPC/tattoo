# This file contains the fastlane.tools configuration
# You can find the documentation at https://docs.fastlane.tools
#
# For a list of all available actions, check out
#     https://docs.fastlane.tools/actions
# For a list of all available plugins, check out
#     https://docs.fastlane.tools/plugins/available-plugins

def changelog(pr_number, pr_title, commit_sha, commit_message)
  prefix = pr_number.to_s.empty? ? pr_title : "PR ##{pr_number}: #{pr_title}"
  "#{prefix}\n#{commit_sha} #{commit_message}"
end

# Prefer the AI-generated store changelog injected by CI; fall back to PR/commit
# info for manual builds where CHANGELOG is unset.
def release_notes(pr_number, pr_title, commit_sha, commit_message)
  generated = ENV["CHANGELOG"].to_s.strip
  generated.empty? ? changelog(pr_number, pr_title, commit_sha, commit_message) : generated
end

def get_build_settings(options)
  {
    build_number: options[:build_number] || ENV["BUILD_NUMBER"],
    version_suffix: options[:version_suffix] || ENV["VERSION_SUFFIX"] || ""
  }
end

platform :ios do
  desc "Build and upload to TestFlight (Preview, Daily, or Production)"
  lane :upload_testflight do |options|
    flavor = options[:flavor] || "prod"
    settings = get_build_settings(options)
    pr_number = options[:pr_number] || ENV["PR_NUMBER"] || ""
    pr_title = options[:pr_title] || ENV["PR_TITLE"] || "manual build"
    commit_sha = options[:commit_sha] || ENV["COMMIT_SHA"] || "manual build"
    commit_message = options[:commit_message] || ENV["COMMIT_MESSAGE"] || "This is a manual build without PR information"
    skip_upload = options[:skip_upload].to_s == "true"
    include_public_testers = options[:include_public_testers].to_s == "true" || ENV["PUBLIC_TESTERS"] == "true"

    setup_ci if is_ci

    sync_code_signing(
      type: "appstore",
      readonly: is_ci,
    )

    bundle_identifier = options[:bundle_identifier] || (["dev", "staging"].include?(flavor) ? (ENV["DEV_IOS_BUNDLE_IDENTIFIER"] || ENV["STAGING_IOS_BUNDLE_IDENTIFIER"] || "club.ntut.tattoo") : (ENV["IOS_BUNDLE_IDENTIFIER"] || "com.npc.tatFlutter"))
    update_code_signing_settings(
      path: "ios/Runner.xcodeproj",
      sdk: "iphoneos*",
      code_sign_identity: "iPhone Distribution",
      profile_name: "match AppStore #{bundle_identifier}",
    )

    Dir.chdir("..") { sh("dart", "run", "tool/credentials.dart", "fetch", "--env=#{flavor}") }

    store_url = options[:store_url] || ENV["STORE_URL"] || ENV["TESTFLIGHT_PUBLIC_LINK"] || ""
    build_args = [
      "--no-codesign",
      "--flavor=#{flavor}",
      "--dart-define=USE_FIREBASE=true",
    ]
    build_args << "--dart-define=VERSION_SUFFIX=#{settings[:version_suffix]}" unless settings[:version_suffix].empty?
    build_args << "--dart-define=STORE_URL=#{store_url}" unless store_url.empty?

    # Build and create xcarchive without code signing
    archive_path = flutter_build(
      build: "ipa",
      build_number: settings[:build_number],
      build_args: build_args,
    )

    build_app(
      skip_build_archive: true,
      archive_path: archive_path,
      export_team_id: ENV["FASTLANE_TEAM_ID"],
      suppress_xcode_output: true,
    )

    next if skip_upload

    crashlytics_binary_paths = [
      File.expand_path("../build/ios/SourcePackages/checkouts/firebase-ios-sdk/Crashlytics/upload-symbols", __dir__),
      File.expand_path("../ios/Pods/FirebaseCrashlytics/upload-symbols", __dir__),
    ]
    upload_symbols_binary_path = crashlytics_binary_paths.find { |candidate| File.file?(candidate) }
    UI.user_error!("Firebase Crashlytics upload-symbols executable not found") unless upload_symbols_binary_path

    upload_symbols_to_crashlytics(
      dsym_path: lane_context[SharedValues::DSYM_OUTPUT_PATH],
      gsp_path: "ios/Runner/GoogleService-Info.plist",
      binary_path: upload_symbols_binary_path,
    )

    app_store_connect_api_key(
      is_key_content_base64: true,
    )

    changelog = release_notes(pr_number, pr_title, commit_sha, commit_message)
    target_groups = include_public_testers ? ["Private External Testers", "Public External Testers"] : ["Private External Testers"]

    upload_to_testflight(
      changelog: changelog,
      distribute_external: true,
      groups: target_groups,
    )
  end

  desc "Build and upload production release to TestFlight"
  lane :release_prod do |options|
    upload_testflight(options.merge(flavor: options[:flavor] || "prod", version_suffix: options[:version_suffix] || ""))
  end
end

platform :android do
  desc "Build release APK"
  lane :build_apk do |options|
    flavor = options[:flavor] || "dev"
    settings = get_build_settings(options)
    Dir.chdir("..") { sh("dart", "run", "tool/credentials.dart", "fetch", "--env=#{flavor}") }

    store_url = options[:store_url] || ENV["STORE_URL"] || ENV["GOOGLEPLAY_PUBLIC_LINK"] || ""
    build_args = [
      "--flavor=#{flavor}",
      "--dart-define=USE_FIREBASE=true",
      "--dart-define=cronetHttpNoPlay=true",
    ]
    build_args << "--dart-define=VERSION_SUFFIX=#{settings[:version_suffix]}" unless settings[:version_suffix].empty?
    build_args << "--dart-define=STORE_URL=#{store_url}" unless store_url.empty?

    flutter_build(
      build: "apk",
      build_number: settings[:build_number],
      build_args: build_args,
    )
  end

  desc "Build release App Bundle (AAB)"
  lane :build_appbundle do |options|
    flavor = options[:flavor] || "prod"
    settings = get_build_settings(options)
    Dir.chdir("..") { sh("dart", "run", "tool/credentials.dart", "fetch", "--env=#{flavor}") }

    store_url = options[:store_url] || ENV["STORE_URL"] || ENV["GOOGLEPLAY_PUBLIC_LINK"] || ""
    build_args = [
      "--flavor=#{flavor}",
      "--dart-define=USE_FIREBASE=true",
      "--dart-define=cronetHttpNoPlay=true",
    ]
    build_args << "--dart-define=VERSION_SUFFIX=#{settings[:version_suffix]}" unless settings[:version_suffix].empty?
    build_args << "--dart-define=STORE_URL=#{store_url}" unless store_url.empty?

    flutter_build(
      build: "appbundle",
      build_number: settings[:build_number],
      build_args: build_args,
    )
  end

  desc "Upload artifact (APK or AAB) to Firebase App Distribution"
  lane :upload_firebase do |options|
    pr_number = options[:pr_number] || ENV["PR_NUMBER"] || ""
    pr_title = options[:pr_title] || ENV["PR_TITLE"] || "manual build"
    commit_sha = options[:commit_sha] || ENV["COMMIT_SHA"] || "manual build"
    commit_message = options[:commit_message] || ENV["COMMIT_MESSAGE"] || "This is a manual build without PR information"
    changelog_text = release_notes(pr_number, pr_title, commit_sha, commit_message)

    artifact_path = options[:apk] || options[:aab] || options[:artifact_path]
    artifact_type = options[:android_artifact_type]

    if artifact_path.nil?
      candidates = [
        Dir.glob(File.expand_path("../build/app/outputs/flutter-apk/*.apk", __dir__)).reject { |f| f.end_with?(".sha1") }.first,
        Dir.glob(File.expand_path("../build/app/outputs/bundle/*/*.aab", __dir__)).first,
        File.expand_path("../build/app/outputs/flutter-apk/app-release.apk", __dir__),
        File.expand_path("../build/app/outputs/bundle/release/app-release.aab", __dir__)
      ].compact
      artifact_path = candidates.find { |f| File.exist?(f) } || candidates.first
      artifact_type ||= (artifact_path && artifact_path.end_with?(".aab")) ? "AAB" : "APK"
    elsif artifact_type.nil?
      artifact_type = artifact_path.end_with?(".aab") ? "AAB" : "APK"
    end

    target_groups = options[:groups] || "dev-tester"

    release = firebase_app_distribution(
      groups: target_groups,
      release_notes: changelog_text,
      android_artifact_type: artifact_type,
      android_artifact_path: artifact_path,
      service_credentials_file: File.expand_path("../service-account.json", __dir__),
    )

    if ENV["GITHUB_OUTPUT"] && release && release[:testingUri]
      File.open(ENV["GITHUB_OUTPUT"], "a") do |f|
        f.puts "testing_uri=#{release[:testingUri]}"
      end
    end
  end

  desc "Upload App Bundle (AAB) to Google Play Store"
  lane :upload_playstore do |options|
    flavor = options[:flavor] || "prod"
    build_number = options[:build_number] || ENV["BUILD_NUMBER"] || 1
    pr_number = options[:pr_number] || ENV["PR_NUMBER"] || ""
    pr_title = options[:pr_title] || ENV["PR_TITLE"] || "manual build"
    commit_sha = options[:commit_sha] || ENV["COMMIT_SHA"] || "manual build"
    commit_message = options[:commit_message] || ENV["COMMIT_MESSAGE"] || "This is a manual build without PR information"

    changelog_text = release_notes(pr_number, pr_title, commit_sha, commit_message)
    ["zh-TW"].each do |locale|
      path = "metadata/android/#{locale}/changelogs"
      FileUtils.mkdir_p(path)
      File.write("#{path}/#{build_number}.txt", changelog_text)
    end

    default_aab = Dir.glob(File.expand_path("../build/app/outputs/bundle/*/*.aab", __dir__)).first ||
                  File.expand_path("../build/app/outputs/bundle/release/app-release.aab", __dir__)
    aab_path = options[:aab] || options[:artifact_path] || default_aab
    track = options[:track] || "internal"

    package_name = options[:package_name] || (["dev", "staging"].include?(flavor) ? (ENV["DEV_ANDROID_PACKAGE_NAME"] || ENV["STAGING_ANDROID_PACKAGE_NAME"] || "club.ntut.tattoo") : (ENV["ANDROID_PACKAGE_NAME"] || "club.ntut.npc.tat"))

    upload_to_play_store(
      package_name: package_name,
      track: track,
      aab: aab_path,
      json_key: File.expand_path("../service-account.json", __dir__),
      skip_upload_metadata: false,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      skip_upload_changelogs: false,
      release_status: options[:release_status] || "completed",
      changes_not_sent_for_review: false
    )
  end

  desc "Build APK and upload PR preview to Firebase App Distribution"
  lane :preview do |options|
    flavor = options[:flavor] || "dev"
    apk = options[:apk]
    apk ||= build_apk(options.merge(flavor: flavor)) unless options[:skip_build].to_s == "true"
    upload_firebase(options.merge(flavor: flavor, apk: apk, android_artifact_type: "APK")) unless options[:skip_upload].to_s == "true"
  end

  desc "Daily release: build APK for Firebase, and optionally AAB for Play Store"
  lane :daily do |options|
    flavor = options[:flavor] || "dev"
    apk = options[:apk]
    apk ||= build_apk(options.merge(flavor: flavor)) unless options[:skip_build].to_s == "true"

    upload_firebase(options.merge(flavor: flavor, apk: apk, android_artifact_type: "APK")) unless options[:skip_upload_firebase].to_s == "true"

    include_public_testers = options[:include_public_testers].to_s == "true" || ENV["PUBLIC_TESTERS"] == "true"
    if include_public_testers && options[:skip_upload_playstore].to_s != "true"
      aab = options[:aab]
      aab ||= build_appbundle(options.merge(flavor: flavor)) unless options[:skip_build].to_s == "true"
      upload_playstore(options.merge(flavor: flavor, aab: aab, track: options[:track] || "beta"))
    end
  end

  desc "Build and upload production release to Google Play Console"
  lane :release_prod do |options|
    flavor = options[:flavor] || "prod"
    aab = options[:aab]
    aab ||= build_appbundle(options.merge(flavor: flavor, version_suffix: options[:version_suffix] || "")) unless options[:skip_build].to_s == "true"
    upload_playstore(options.merge(flavor: flavor, aab: aab, track: options[:track] || "internal")) unless options[:skip_upload].to_s == "true"
  end

  # Backward compatibility alias for release
  desc "Alias for daily release or full release"
  lane :release do |options|
    daily(options)
  end
end
