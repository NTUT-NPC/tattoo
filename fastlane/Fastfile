# This file contains the fastlane.tools configuration
# You can find the documentation at https://docs.fastlane.tools

require "fileutils"

PROJECT_ROOT = File.expand_path("..", __dir__)

def changelog(pr_number, pr_title, commit_sha, commit_message)
  prefix = pr_number.to_s.empty? ? pr_title : "PR ##{pr_number}: #{pr_title}"
  "#{prefix}\n#{commit_sha} #{commit_message}"
end

# Prefer the AI-generated store changelog injected by CI; fall back to PR/commit
# info for manual builds where CHANGELOG is unset.
def release_notes(pr_number, pr_title, commit_sha, commit_message)
  generated = ENV["CHANGELOG"].to_s.strip
  generated.empty? ? changelog(pr_number, pr_title, commit_sha, commit_message) : generated
end

def required_file(path, description)
  UI.user_error!("#{description} path is required") if path.to_s.empty?

  absolute_path = File.expand_path(path, PROJECT_ROOT)
  UI.user_error!("#{description} not found at #{absolute_path}") unless File.file?(absolute_path)

  absolute_path
end

def release_metadata(options)
  {
    pr_number: options[:pr_number] || ENV["PR_NUMBER"] || "",
    pr_title: options[:pr_title] || ENV["PR_TITLE"] || "manual build",
    commit_sha: options[:commit_sha] || ENV["COMMIT_SHA"] || "manual build",
    commit_message: options[:commit_message] || ENV["COMMIT_MESSAGE"] || "This is a manual build without PR information"
  }
end

platform :ios do
  desc "Install and configure iOS signing credentials"
  lane :prepare_signing do |options|
    flavor = options[:env] || "staging"

    setup_ci if is_ci

    sync_code_signing(
      type: "appstore",
      readonly: is_ci
    )

    update_code_signing_settings(
      path: File.join(PROJECT_ROOT, "ios", "Runner.xcodeproj"),
      targets: ["Runner"],
      build_configurations: ["Release-#{flavor}"],
      sdk: "iphoneos*",
      team_id: ENV["FASTLANE_TEAM_ID"],
      code_sign_identity: "Apple Distribution",
      profile_name: "match AppStore #{ENV['IOS_BUNDLE_IDENTIFIER']}"
    )
  end

  desc "Upload an existing IPA to TestFlight"
  lane :upload_testflight do |options|
    ipa_path = required_file(options[:ipa], "iOS IPA")
    metadata = release_metadata(options)
    include_public_testers = options[:include_public_testers].to_s == "true" || ENV["PUBLIC_TESTERS"] == "true"
    internal_only = options[:internal_only].to_s == "true"
    test_notes = release_notes(*metadata.values)
    if !internal_only && test_notes.strip.empty?
      UI.user_error!("TestFlight test notes are required for external distribution")
    end

    app_store_connect_api_key(is_key_content_base64: true)

    target_groups = if include_public_testers
                      ["Private External Testers", "Public External Testers"]
                    else
                      ["Private External Testers"]
                    end

    upload_to_testflight(
      ipa: ipa_path,
      changelog: test_notes,
      distribute_external: !internal_only,
      groups: internal_only ? nil : target_groups,
      skip_waiting_for_build_processing: false
    )
  end

  desc "Upload an existing dSYM archive to Firebase Crashlytics"
  lane :upload_symbols do |options|
    upload_symbols_to_crashlytics(
      dsym_path: required_file(options[:dsym], "iOS dSYM archive"),
      gsp_path: required_file(options[:gsp], "Firebase iOS configuration"),
      binary_path: required_file(options[:upload_symbols_binary], "Firebase Crashlytics upload-symbols executable"),
      fail_on_error: true
    )
  end
end

platform :android do
  desc "Upload an existing App Bundle to Firebase App Distribution"
  lane :upload_firebase do |options|
    metadata = release_metadata(options)
    release = firebase_app_distribution(
      groups: "dev-tester",
      release_notes: release_notes(*metadata.values),
      android_artifact_type: "AAB",
      android_artifact_path: required_file(options[:aab], "Android App Bundle"),
      service_credentials_file: required_file(options[:service_credentials_file], "Android upload service account")
    )

    if ENV["GITHUB_OUTPUT"]
      File.open(ENV["GITHUB_OUTPUT"], "a") do |file|
        file.puts "testing_uri=#{release.fetch(:testingUri)}"
      end
    end
  end

  desc "Upload an existing App Bundle to Google Play"
  lane :upload_play_store do |options|
    build_number = options[:build_number] || ENV["BUILD_NUMBER"] || 1
    metadata = release_metadata(options)
    changelog_text = release_notes(*metadata.values)
    changelog_directory = File.join(PROJECT_ROOT, "fastlane", "metadata", "android", "zh-TW", "changelogs")
    FileUtils.mkdir_p(changelog_directory)
    File.write(File.join(changelog_directory, "#{build_number}.txt"), changelog_text)

    track = options[:track].to_s
    UI.user_error!("Google Play track is required") if track.empty?

    upload_to_play_store(
      package_name: ENV["ANDROID_PACKAGE_NAME"],
      track: track,
      aab: required_file(options[:aab], "Android App Bundle"),
      json_key: required_file(options[:service_credentials_file], "Android upload service account"),
      skip_upload_metadata: false,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      skip_upload_changelogs: false,
      release_status: "completed",
      changes_not_sent_for_review: false
    )
  end
end
