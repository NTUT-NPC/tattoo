# This file contains the fastlane.tools configuration
# You can find the documentation at https://docs.fastlane.tools

require "fileutils"

PROJECT_ROOT = File.expand_path("..", __dir__)
CI_ANDROID_DIR = File.join(PROJECT_ROOT, "build", "ci", "android")
CI_IOS_DIR = File.join(PROJECT_ROOT, "build", "ci", "ios")

def changelog(pr_number, pr_title, commit_sha, commit_message)
  prefix = pr_number.to_s.empty? ? pr_title : "PR ##{pr_number}: #{pr_title}"
  "#{prefix}\n#{commit_sha} #{commit_message}"
end

# Prefer the AI-generated store changelog injected by CI; fall back to PR/commit
# info for manual builds where CHANGELOG is unset.
def release_notes(pr_number, pr_title, commit_sha, commit_message)
  generated = ENV["CHANGELOG"].to_s.strip
  generated.empty? ? changelog(pr_number, pr_title, commit_sha, commit_message) : generated
end

def get_build_settings(options)
  {
    build_number: options[:build_number] || ENV["BUILD_NUMBER"],
    version_suffix: options[:version_suffix] || ENV["VERSION_SUFFIX"] || ""
  }
end

def required_file(path, description)
  UI.user_error!("#{description} path is required") if path.to_s.empty?

  absolute_path = File.expand_path(path, PROJECT_ROOT)
  UI.user_error!("#{description} not found at #{absolute_path}") unless File.file?(absolute_path)

  absolute_path
end

def required_directory(path, description)
  UI.user_error!("#{description} path is required") if path.to_s.empty?

  absolute_path = File.expand_path(path, PROJECT_ROOT)
  UI.user_error!("#{description} not found at #{absolute_path}") unless File.directory?(absolute_path)

  absolute_path
end

def stage_file(source, destination)
  FileUtils.cp(source, destination) unless File.expand_path(source) == File.expand_path(destination)
end

def prepare_output_directory(path)
  FileUtils.rm_rf(path)
  FileUtils.mkdir_p(path)
end

def build_arguments(flavor, version_suffix, store_url, android: false)
  arguments = [
    "--dart-define=USE_FIREBASE=true",
    "--flavor=#{flavor}"
  ]
  arguments << "--dart-define=cronetHttpNoPlay=true" if android
  arguments << "--dart-define=VERSION_SUFFIX=#{version_suffix}" unless version_suffix.empty?
  arguments << "--dart-define=STORE_URL=#{store_url}" unless store_url.to_s.empty?
  arguments
end

def release_metadata(options)
  {
    pr_number: options[:pr_number] || ENV["PR_NUMBER"] || "",
    pr_title: options[:pr_title] || ENV["PR_TITLE"] || "manual build",
    commit_sha: options[:commit_sha] || ENV["COMMIT_SHA"] || "manual build",
    commit_message: options[:commit_message] || ENV["COMMIT_MESSAGE"] || "This is a manual build without PR information"
  }
end

platform :ios do
  desc "Build an iOS IPA and stage its Crashlytics inputs"
  lane :build do |options|
    flavor = options[:env] || "staging"
    settings = get_build_settings(options)
    store_url = options[:store_url] || ""

    prepare_output_directory(CI_IOS_DIR)
    setup_ci if is_ci

    sync_code_signing(
      type: "appstore",
      readonly: is_ci
    )

    update_code_signing_settings(
      path: File.join(PROJECT_ROOT, "ios", "Runner.xcodeproj"),
      sdk: "iphoneos*",
      code_sign_identity: "iPhone Distribution",
      profile_name: "match AppStore #{ENV['IOS_BUNDLE_IDENTIFIER']}"
    )

    Dir.chdir(PROJECT_ROOT) do
      sh("dart", "run", "tool/credentials.dart", "fetch-build", "ios", flavor)
    end

    archive_path = flutter_build(
      build: "ipa",
      build_number: settings[:build_number],
      build_args: [
        "--no-codesign",
        *build_arguments(flavor, settings[:version_suffix], store_url)
      ]
    )
    archive_path = required_directory(archive_path, "iOS archive")

    build_app(
      skip_build_archive: true,
      archive_path: archive_path,
      export_team_id: ENV["FASTLANE_TEAM_ID"],
      suppress_xcode_output: true,
      output_directory: CI_IOS_DIR,
      output_name: "tattoo.ipa"
    )

    required_file(File.join(CI_IOS_DIR, "tattoo.ipa"), "iOS IPA")
    dsym_path = required_file(lane_context[SharedValues::DSYM_OUTPUT_PATH], "iOS dSYM archive")
    gsp_path = required_file(
      File.join(PROJECT_ROOT, "ios", "Runner", "GoogleService-Info-#{flavor}.plist"),
      "Firebase iOS configuration"
    )
    upload_symbols_path = required_file(
      File.join(PROJECT_ROOT, "build", "ios", "SourcePackages", "checkouts", "firebase-ios-sdk", "Crashlytics", "upload-symbols"),
      "Firebase Crashlytics upload-symbols executable"
    )

    stage_file(dsym_path, File.join(CI_IOS_DIR, "tattoo.app.dSYM.zip"))
    stage_file(gsp_path, File.join(CI_IOS_DIR, "GoogleService-Info.plist"))
    staged_upload_symbols = File.join(CI_IOS_DIR, "upload-symbols")
    stage_file(upload_symbols_path, staged_upload_symbols)
    FileUtils.chmod(0o755, staged_upload_symbols)

    required_file(File.join(CI_IOS_DIR, "tattoo.app.dSYM.zip"), "staged iOS dSYM archive")
    required_file(File.join(CI_IOS_DIR, "GoogleService-Info.plist"), "staged Firebase iOS configuration")
    required_file(staged_upload_symbols, "staged Firebase Crashlytics upload-symbols executable")
  end

  desc "Upload an existing IPA to TestFlight"
  lane :upload_testflight do |options|
    ipa_path = required_file(options[:ipa], "iOS IPA")
    metadata = release_metadata(options)
    include_public_testers = options[:include_public_testers].to_s == "true" || ENV["PUBLIC_TESTERS"] == "true"
    internal_only = options[:internal_only].to_s == "true"
    test_notes = release_notes(*metadata.values)
    if !internal_only && test_notes.strip.empty?
      UI.user_error!("TestFlight test notes are required for external distribution")
    end

    app_store_connect_api_key(is_key_content_base64: true)

    target_groups = if include_public_testers
                      ["Private External Testers", "Public External Testers"]
                    else
                      ["Private External Testers"]
                    end

    begin
      upload_to_testflight(
        ipa: ipa_path,
        changelog: test_notes,
        distribute_external: !internal_only,
        groups: internal_only ? nil : target_groups,
        skip_waiting_for_build_processing: false
      )
    rescue => error
      expected_beta_review_conflict =
        !internal_only &&
        error.message.include?("Another build is in review") &&
        error.message.include?("Another build in the same train is already in beta review")
      raise unless expected_beta_review_conflict

      UI.important("TestFlight upload completed, but external distribution is waiting for the build already in beta review")
      if ENV["GITHUB_OUTPUT"]
        File.open(ENV["GITHUB_OUTPUT"], "a") do |file|
          file.puts "beta_review_blocked=true"
        end
      end
    end
  end

  desc "Upload an existing dSYM archive to Firebase Crashlytics"
  lane :upload_symbols do |options|
    upload_symbols_to_crashlytics(
      dsym_path: required_file(options[:dsym], "iOS dSYM archive"),
      gsp_path: required_file(options[:gsp], "Firebase iOS configuration"),
      binary_path: required_file(options[:upload_symbols_binary], "Firebase Crashlytics upload-symbols executable"),
      fail_on_error: true
    )
  end
end

platform :android do
  desc "Build an Android App Bundle and optionally an APK"
  lane :build do |options|
    flavor = options[:env] || "staging"
    settings = get_build_settings(options)
    store_url = options[:store_url] || ""
    include_apk = options[:include_apk].to_s == "true"

    prepare_output_directory(CI_ANDROID_DIR)
    Dir.chdir(PROJECT_ROOT) do
      sh("dart", "run", "tool/credentials.dart", "fetch-build", "android", flavor)
    end

    arguments = build_arguments(
      flavor,
      settings[:version_suffix],
      store_url,
      android: true
    )
    aab_path = flutter_build(
      build: "appbundle",
      build_number: settings[:build_number],
      build_args: arguments
    )
    FileUtils.cp(
      required_file(aab_path, "Android App Bundle"),
      File.join(CI_ANDROID_DIR, "tattoo.aab")
    )

    if include_apk
      apk_path = flutter_build(
        build: "apk",
        build_number: settings[:build_number],
        build_args: arguments
      )
      FileUtils.cp(
        required_file(apk_path, "Android APK"),
        File.join(CI_ANDROID_DIR, "tattoo.apk")
      )
    end

    required_file(File.join(CI_ANDROID_DIR, "tattoo.aab"), "staged Android App Bundle")
    required_file(File.join(CI_ANDROID_DIR, "tattoo.apk"), "staged Android APK") if include_apk
  end

  desc "Upload an existing App Bundle to Firebase App Distribution"
  lane :upload_firebase do |options|
    metadata = release_metadata(options)
    release = firebase_app_distribution(
      groups: "dev-tester",
      release_notes: release_notes(*metadata.values),
      android_artifact_type: "AAB",
      android_artifact_path: required_file(options[:aab], "Android App Bundle"),
      service_credentials_file: required_file(options[:service_credentials_file], "Android upload service account")
    )

    if ENV["GITHUB_OUTPUT"]
      File.open(ENV["GITHUB_OUTPUT"], "a") do |file|
        file.puts "testing_uri=#{release[:testingUri]}"
      end
    end
  end

  desc "Upload an existing App Bundle to Google Play"
  lane :upload_play_store do |options|
    build_number = options[:build_number] || ENV["BUILD_NUMBER"] || 1
    metadata = release_metadata(options)
    changelog_text = release_notes(*metadata.values)
    changelog_directory = File.join(PROJECT_ROOT, "fastlane", "metadata", "android", "zh-TW", "changelogs")
    FileUtils.mkdir_p(changelog_directory)
    File.write(File.join(changelog_directory, "#{build_number}.txt"), changelog_text)

    track = options[:track].to_s
    UI.user_error!("Google Play track is required") if track.empty?

    upload_to_play_store(
      package_name: ENV["ANDROID_PACKAGE_NAME"],
      track: track,
      aab: required_file(options[:aab], "Android App Bundle"),
      json_key: required_file(options[:service_credentials_file], "Android upload service account"),
      skip_upload_metadata: false,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      skip_upload_changelogs: false,
      release_status: "completed",
      changes_not_sent_for_review: false
    )
  end
end
