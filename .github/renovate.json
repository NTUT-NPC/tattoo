{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":maintainLockFilesDisabled"
  ],
  "timezone": "Asia/Taipei",
  "schedule": ["* * 2 * *"],
  "prHourlyLimit": 0,
  "constraints": {
    "flutter": "3.47.2"
  },
  "bundler": {
    "managerFilePatterns": ["/(^|/)Pluginfile$/"]
  },
  "packageRules": [
    {
      "matchPackageNames": ["dart", "dev.flutter.flutter-plugin-loader"],
      "enabled": false
    },
    {
      "matchManagers": ["mise"],
      "matchDepNames": ["java"],
      "enabled": false
    },
    {
      "matchManagers": ["github-actions"],
      "matchPackageNames": ["ruby/setup-ruby"],
      "pinDigests": false
    },
    {
      "matchManagers": ["pub"],
      "groupName": "Flutter dependencies",
      "groupSlug": "pub",
      "rangeStrategy": "bump",
      "versioning": "npm"
    },
    {
      "matchFileNames": ["android/**"],
      "groupName": "Android dependencies",
      "groupSlug": "android"
    },
    {
      "matchFileNames": ["ios/**"],
      "groupName": "iOS dependencies",
      "groupSlug": "ios"
    },
    {
      "matchFileNames": [
        ".github/**",
        "Gemfile",
        "fastlane/Pluginfile",
        "doc/Dockerfile"
      ],
      "groupName": "CI dependencies",
      "groupSlug": "ci"
    },
    {
      "matchDepNames": ["flutter"],
      "groupName": "Flutter SDK",
      "groupSlug": "flutter"
    },
    {
      "matchUpdateTypes": ["major"],
      "groupName": null,
      "groupSlug": null
    }
  ]
}
